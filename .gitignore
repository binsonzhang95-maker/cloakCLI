# Rust
/target/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
*.egg

# Env / secrets
.env
.env.*
!.env.example
config/llm.json
config/llm_models_cache.json
config/llm.secret

# Runtime / local state
data/profiles/
data/sessions*
data/user-data/
data/artifacts/
artifacts/
# Profiles: allow profile.json metadata; deny cookie secrets + other local files
profiles/*
!profiles/.gitkeep
!profiles/*/
!profiles/*/profile.json
data/*
!data/.gitkeep

# Teach export secrets (password vars sidecar)
skills/**/secrets.json
skills/**/*.secret
skills/**/.env

# Cookie secrets — never commit (defense in depth; also under profiles/)
**/cookie.json
**/cookies-export*.json
**/storage_state*.json
!fixtures/**
*.cookies.json
cookies-export.json

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Screenshots / skill artifacts
*.png
!desktop/src-tauri/icons/*.png

# verify script export artifact
cookie-export-verify.json

# Local Astra prompts / scratch (keep review markdown if useful — ignore ask-*)
ask-astra*.txt
ask-grok*.md
astra-review-run.log
grok-*-run.log
*.bak
screenshots/

# Desktop (Tauri) — keep source; ignore build artifacts
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
data/secrets/
