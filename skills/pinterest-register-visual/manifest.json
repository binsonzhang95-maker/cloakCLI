{
  "version": "0.2.5",
  "entry": {
    "kind": "python_runner",
    "path": "scripts/run_pinterest_register_visual_mm.py"
  },
  "secrets": [
    "PINTEREST_EMAIL",
    "PINTEREST_PASSWORD",
    "OUTLOOK_EMAIL",
    "OUTLOOK_CLIENT_ID",
    "OUTLOOK_REFRESH_TOKEN"
  ],
  "statuses": [
    {
      "id": "registered_ok",
      "success": true,
      "retryable": false,
      "label": "Registered / logged in",
      "exit": 0
    },
    {
      "id": "browsed_ok",
      "success": true,
      "retryable": false,
      "label": "Nurture browse OK (optional chain)",
      "optional": true,
      "exit": 0
    },
    {
      "id": "oops_blocked",
      "success": false,
      "retryable": false,
      "label": "Pinterest Oops — park",
      "exit": 2
    },
    {
      "id": "verify_soft_fail",
      "success": false,
      "retryable": true,
      "label": "Verify soft fail (retryable)",
      "exit": 5
    },
    {
      "id": "account_deactivated",
      "success": false,
      "retryable": false,
      "label": "Account deactivated",
      "exit": 7
    },
    {
      "id": "not_logged_in",
      "success": false,
      "retryable": true,
      "label": "Not logged in",
      "exit": 8
    },
    {
      "id": "visual_stuck",
      "success": false,
      "retryable": true,
      "label": "Visual MM loop stuck",
      "exit": 4
    }
  ]
}
